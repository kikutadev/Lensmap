---
import type { Locale, SiteCopy } from "../content/site";

interface Props {
  locale: Locale;
  copy: SiteCopy;
}

const { locale, copy } = Astro.props;
const isJa = locale === "ja";
const languageHref = isJa ? "/en/" : "/";
const languageLabel = isJa ? "EN" : "日本語";
const releaseUrl = "https://github.com/kikutadev/Lensmap/releases";
const repoUrl = "https://github.com/kikutadev/Lensmap";
---
<div class="site-shell">
  <header class="site-header" aria-label="Lensmap">
    <a class="brand" href={isJa ? "/" : "/en/"} aria-label="Lensmap home">
      <img src="/icons/icon-256.png" alt="" width="30" height="30" />
      <span>Lensmap</span>
    </a>
    <nav class="site-nav" aria-label={isJa ? "主要ナビゲーション" : "Primary navigation"}>
      <a href="#how">{copy.navHow}</a>
      <a href="#maps">{copy.navMaps}</a>
      <a href="#install">{copy.navInstall}</a>
      <a href="#faq">{copy.navFaq}</a>
      <a href="https://github.com/kikutadev/Lensmap/blob/main/PRIVACY.md">{copy.navPrivacy}</a>
      <a class="language-link" href={languageHref} hreflang={isJa ? "en" : "ja"}>{languageLabel}</a>
    </nav>
  </header>

  <main>
    <section class="hero section-pad" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow">{copy.eyebrow}</p>
        <h1 id="hero-title">{copy.heroTitle.split("\n").map((line, index) => <>{index > 0 && <br />}<span>{line}</span></>)}</h1>
        <p class="hero-body">{copy.heroBody}</p>
        <div class="hero-actions">
          <a class="button primary" href={repoUrl}>{copy.primaryCta}</a>
          <a class="button secondary" href="#how">{copy.secondaryCta}</a>
        </div>
        <p class="hero-hint">{copy.heroHint}</p>
      </div>

      <div class="hero-product" aria-label={isJa ? "PDF本文とLensmapのExplore画面" : "PDF passage alongside Lensmap Explore"}>
        <div class="browser-frame">
          <div class="browser-toolbar" aria-hidden="true">
            <span class="traffic"><i></i><i></i><i></i></span>
            <span class="browser-title">PMBOK Guide 7 — Underneath the Surface.pdf</span>
          </div>
          <div class="reader-stage">
            <article class="pdf-page" aria-label={isJa ? "PDFの例" : "Example PDF passage"}>
              <div class="pdf-kicker">Selecting a Methodology</div>
              <h2>P3.express</h2>
              <p>P3.express is presented as an open, minimalist project management methodology.</p>
              <p class="selected-passage">It is intended for most small, medium, and large projects, but not micro- or mega-projects.</p>
              <p>Other passages position PRINCE2, Scrum, and PM² differently — useful when choosing what fits a project.</p>
              <div class="margin-note">p. 45</div>
            </article>
            <div class="panel-shot actual-map-shot" aria-label={isJa ? "Lensmapで実際に生成したComparison Map" : "Actual Comparison Map generated by Lensmap"}>
              <span class="actual-map-label">{isJa ? "実際のMap" : "Actual Map"}</span>
              <img
                src={isJa ? "/product/pmbok-comparison-ja.png" : "/product/pmbok-comparison-en.png"}
                alt=""
                width="1296"
                height={isJa ? "1186" : "1242"}
                fetchpriority="high"
                decoding="async"
              />
            </div>
          </div>
        </div>
        <div class="hero-callouts" aria-hidden="true">
          <span class="callout selected">{copy.sourceLabel}</span>
          <span class="callout expanded">{isJa ? "4つのEvidence" : "4 Evidence"}</span>
          <span class="callout saved">{copy.mapSavedLabel}</span>
        </div>
      </div>
    </section>

    <section id="how" class="core-loop section-pad" aria-labelledby="how-title">
      <div class="section-heading compact">
        <p class="eyebrow">Focus → Expand → Map</p>
        <h2 id="how-title">{copy.ownershipTitle}</h2>
      </div>
      <ol class="loop-grid">
        <li>
          <span class="step-number">01</span>
          <h3>{copy.focusTitle}</h3>
          <p>{copy.focusBody}</p>
        </li>
        <li>
          <span class="step-number">02</span>
          <h3>{copy.expandTitle}</h3>
          <p>{copy.expandBody}</p>
        </li>
        <li>
          <span class="step-number">03</span>
          <h3>{copy.mapTitle}</h3>
          <p>{copy.mapBody}</p>
        </li>
      </ol>

      <aside class="chat-note" aria-label={copy.chatTitle}>
        <div class="chat-note-mark" aria-hidden="true">⌘</div>
        <div>
          <p class="eyebrow">{copy.chatEyebrow}</p>
          <h3>{copy.chatTitle}</h3>
          <p>{copy.chatBody}</p>
        </div>
      </aside>
    </section>

    <section id="maps" class="map-showcase section-pad" aria-labelledby="maps-title">
      <div class="section-heading wide">
        <p class="eyebrow">{copy.mapsEyebrow}</p>
        <h2 id="maps-title">{copy.mapsTitle}</h2>
        <p>{copy.mapsBody}</p>
      </div>

      <div class="real-map-example">
        <div class="real-map-context">
          <p class="eyebrow">{copy.mapExampleEyebrow}</p>
          <h3>{copy.mapExampleTitle}</h3>
          <p>{copy.mapExampleBody}</p>
          <dl class="map-example-stats">
            <div><dt>4</dt><dd>{copy.mapExampleSelected}</dd></div>
            <div><dt>1</dt><dd>{copy.mapExampleOutcome}</dd></div>
            <div><dt>S1–S4</dt><dd>{copy.mapExampleEvidence}</dd></div>
          </dl>
        </div>

        <figure class="real-map-figure">
          <img
            src={isJa ? "/product/pmbok-comparison-ja.png" : "/product/pmbok-comparison-en.png"}
            alt={copy.mapExampleAlt}
            width="1296"
            height={isJa ? "1186" : "1242"}
            loading="lazy"
            decoding="async"
          />
          <figcaption>{copy.mapExampleCaption}</figcaption>
        </figure>
      </div>

      <p class="map-source-attribution">
        {copy.mapSourceLead}
        <a href="https://pmbok.guide/" target="_blank" rel="noreferrer">Nader K. Rad, <em>PMBOK® Guide 7, Underneath the Surface</em></a>
        {copy.mapSourceTail}
      </p>
    </section>

    <section class="principles section-pad" aria-label={isJa ? "Lensmapの原則" : "Lensmap principles"}>
      <article>
        <div class="principle-icon" aria-hidden="true">↩</div>
        <h2>{copy.groundedTitle}</h2>
        <p>{copy.groundedBody}</p>
      </article>
      <article>
        <div class="principle-icon" aria-hidden="true">⌂</div>
        <h2>{copy.localTitle}</h2>
        <p>{copy.localBody}</p>
      </article>
    </section>

    <section class="codex-section section-pad" aria-labelledby="codex-title">
      <div class="section-heading wide">
        <p class="eyebrow">{copy.codexEyebrow}</p>
        <h2 id="codex-title">{copy.codexTitle}</h2>
        <p>{copy.codexBody}</p>
      </div>
      <div class="codex-architecture" aria-label={isJa ? "LensmapとCodex App Serverの構成" : "Lensmap and Codex App Server architecture"}>
        <div class="architecture-node">
          <span>Chrome</span>
          <strong>Lensmap Side Panel</strong>
          <small>{isJa ? "Focus / Explore / Maps" : "Focus / Explore / Maps"}</small>
        </div>
        <span class="architecture-arrow" aria-hidden="true">→</span>
        <div class="architecture-node local-node">
          <span>Local</span>
          <strong>Lensmap Server</strong>
          <small>{isJa ? "PDF索引・Evidence・retrieval" : "PDF index · Evidence · retrieval"}</small>
        </div>
        <span class="architecture-arrow" aria-hidden="true">→</span>
        <div class="architecture-node codex-node">
          <span>AI runtime</span>
          <strong>Codex App Server</strong>
          <small>{isJa ? "認証済みCodex session" : "Authenticated Codex session"}</small>
        </div>
      </div>
      <ul class="codex-points">
        <li>{copy.codexPoint1}</li>
        <li>{copy.codexPoint2}</li>
        <li>{copy.codexPoint3}</li>
      </ul>
    </section>

    <section id="install" class="install section-pad" aria-labelledby="install-title">
      <div class="install-intro">
        <p class="eyebrow">{copy.installEyebrow}</p>
        <h2 id="install-title">{copy.installTitle}</h2>
        <p>{copy.installBody}</p>
      </div>
      <ol class="install-steps">
        <li><span>1</span><div><strong>{copy.installStep1Title}</strong><p>{copy.installStep1Body}</p></div></li>
        <li><span>2</span><div><strong>{copy.installStep2Title}</strong><p>{copy.installStep2Body}</p></div></li>
        <li><span>3</span><div><strong>{copy.installStep3Title}</strong><p>{copy.installStep3Body}</p></div></li>
        <li><span>4</span><div><strong>{copy.installStep4Title}</strong><p>{copy.installStep4Body}</p></div></li>
      </ol>
      <div class="source-install">
        <div>
          <span class="source-install-label">{isJa ? "今すぐsource buildで試す" : "Try the source build now"}</span>
          <p>{isJa ? "Node.js 22.13以上がある開発環境では、次の3コマンドでbuildとNative Host登録まで進められます。" : "With Node.js 22.13 or later, these three commands build Lensmap and register the Native Host."}</p>
        </div>
        <pre><code>npm install
npm run build
npm run native-host:install</code></pre>
        <p class="source-install-path">Load unpacked: <code>apps/chrome-extension/.output/chrome-mv3</code></p>
      </div>
      <div class="install-footer">
        <p class="install-note">{copy.installNote}</p>
        <div class="install-actions">
          <a class="button primary" href="https://github.com/kikutadev/Lensmap#開発セットアップ">{isJa ? "READMEで試す" : "Try from the README"}</a>
          <a class="text-link" href={releaseUrl}>{isJa ? "GitHub Releases（準備中）↗" : "GitHub Releases (preparing) ↗"}</a>
        </div>
      </div>
    </section>

    <section id="faq" class="faq section-pad" aria-labelledby="faq-title">
      <div class="section-heading compact">
        <p class="eyebrow">{copy.faqEyebrow}</p>
        <h2 id="faq-title">{copy.faqTitle}</h2>
      </div>
      <div class="faq-list">
        {copy.faqItems.map((item) => (
          <details>
            <summary>{item.question}<span aria-hidden="true">＋</span></summary>
            <p>{item.answer}</p>
          </details>
        ))}
      </div>
    </section>
  </main>

  <footer class="site-footer section-pad">
    <div class="footer-brand">
      <img src="/icons/icon-256.png" alt="" width="24" height="24" />
      <span>Lensmap</span>
    </div>
    <p>{copy.footerLine}</p>
    <div class="footer-links">
      <a href={repoUrl}>GitHub</a>
      <a href="https://github.com/kikutadev/Lensmap/blob/main/PRIVACY.md">Privacy</a>
      <a href="https://github.com/kikutadev/Lensmap/blob/main/SECURITY.md">Security</a>
      <a href="https://github.com/kikutadev/Lensmap/blob/main/LICENSE">Apache-2.0</a>
    </div>
  </footer>
</div>
